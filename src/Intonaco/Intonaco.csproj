<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\intonaco.ico</ApplicationIcon>
    <AssemblyName>Intonaco</AssemblyName>
    <RootNamespace>Intonaco</RootNamespace>
    <Title>Intonaco Wallpaper</Title>
    <Product>Intonaco Wallpaper</Product>
    <Description>Intonaco GPU video wallpapers for Windows 10 and 11</Description>
    <Company>Acev Dev Co</Company>
    <Copyright>Copyright © 2026 Intonaco Contributors</Copyright>
    <Authors>Intonaco Contributors</Authors>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <!-- RuntimeIdentifier / SelfContained are supplied by publish commands
         (build.ps1, CI) so plain `dotnet build` / `dotnet test` stay RID-agnostic. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The UI ships in English; avoid carrying every runtime satellite
         assembly in self-contained downloads/installers. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Explicit workstation GC keeps the single UI process biased toward
         returning memory instead of retaining server-sized heaps. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Store packaging opts into WinRT startup-task APIs without changing
       the existing unpackaged GitHub executable or its runtime target. -->
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants>$(DefineConstants);INTONACO_STORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <Resource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <!-- The original GPU renderer is compiled from native/IntonacoVideo on
       Windows build agents. Native binary is carried inside our own installer
       and the portable single-file build; users install no other app. -->
  <ItemGroup Condition="Exists('native\Intonaco.Video.dll')">
    <Content Include="native\Intonaco.Video.dll" Link="Intonaco.Video.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Intonaco.Tests" />
  </ItemGroup>

</Project>
