<Window x:Class="Intonaco.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Intonaco"
        Icon="/Assets/intonaco.ico"
        Width="440" Height="458"
        MinWidth="440" MinHeight="458"
        MaxWidth="440" MaxHeight="458"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource DefaultFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="54" Height="54" Background="{DynamicResource SubtleBackgroundBrush}"
                    CornerRadius="14">
                <Viewbox Margin="5">
                    <Canvas Width="64" Height="64">
                        <Path Data="M18,43 L18,24 Q18,18 24,18 L44,18"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Path Data="M46,21 L46,40 Q46,46 40,46 L20,46"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Path Data="M25,37 Q31,25 38,33"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Margin="14,3,0,0" VerticalAlignment="Center">
                <TextBlock Text="Intonaco" FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="AboutVersionText" Text="Version"
                           Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Local video wallpapers for Windows. Choose the built-in Windows player or an optional MPV backend."
                   FontSize="13" TextWrapping="Wrap" LineHeight="21"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,19" />

        <TextBlock Grid.Row="2" Text="Links and support" FontSize="13"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,9" />

        <StackPanel Grid.Row="3">
            <Button Style="{StaticResource GhostButton}" Height="43"
                    HorizontalContentAlignment="Left" Click="OnOpenGitHub"
                    ToolTip="Open the Intonaco source code on GitHub">
                <DockPanel LastChildFill="True">
                    <Viewbox Width="21" Height="21" Margin="4,0,12,0"
                              Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                                  Fill="{DynamicResource TextPrimaryBrush}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="GitHub" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
            </Button>
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,1" />
            <Button Style="{StaticResource GhostButton}" Height="43"
                    HorizontalContentAlignment="Left" Click="OnOpenPayPal"
                    ToolTip="Support Intonaco through PayPal">
                <DockPanel LastChildFill="True">
                    <Viewbox Width="21" Height="21" Margin="4,0,12,0"
                              Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="24" Height="24">
                            <Path Data="M15.607 4.653H8.941L6.645 19.251H1.82L4.862 0h7.995c3.754 0 6.375 2.294 6.473 5.513-.648-.478-2.105-.86-3.722-.86m6.57 5.546c0 3.41-3.01 6.853-6.958 6.853h-2.493L11.595 24H6.74l1.845-11.538h3.592c4.208 0 7.346-3.634 7.153-6.949a5.24 5.24 0 0 1 2.848 4.686M9.653 5.546h6.408c.907 0 1.942.222 2.363.541-.195 2.741-2.655 5.483-6.441 5.483H8.714Z"
                                  Fill="#1487C8" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Support on PayPal" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
            </Button>
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,1" />
            <Button Style="{StaticResource GhostButton}" Height="43"
                    HorizontalContentAlignment="Left" Click="OnOpenKoFi"
                    ToolTip="Support Intonaco through Ko-fi">
                <DockPanel LastChildFill="True">
                    <Viewbox Width="21" Height="21" Margin="4,0,12,0"
                              Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="24" Height="24">
                            <Path Data="M11.351 2.715c-2.7 0-4.986.025-6.83.26C2.078 3.285 0 5.154 0 8.61c0 3.506.182 6.13 1.585 8.493 1.584 2.701 4.233 4.182 7.662 4.182h.83c4.209 0 6.494-2.234 7.637-4a9.5 9.5 0 0 0 1.091-2.338C21.792 14.688 24 12.22 24 9.208v-.415c0-3.247-2.13-5.507-5.792-5.87-1.558-.156-2.65-.208-6.857-.208m0 1.947c4.208 0 5.09.052 6.571.182 2.624.311 4.13 1.584 4.13 4v.39c0 2.156-1.792 3.844-3.87 3.844h-.935l-.156.649c-.208 1.013-.597 1.818-1.039 2.546-.909 1.428-2.545 3.064-5.922 3.064h-.805c-2.571 0-4.831-.883-6.078-3.195-1.09-2-1.298-4.155-1.298-7.506 0-2.181.857-3.402 3.012-3.714 1.533-.233 3.559-.26 6.39-.26m6.547 2.287c-.416 0-.65.234-.65.546v2.935c0 .311.234.545.65.545 1.324 0 2.051-.754 2.051-2s-.727-2.026-2.052-2.026m-10.39.182c-1.818 0-3.013 1.48-3.013 3.142 0 1.533.858 2.857 1.949 3.897.727.701 1.87 1.429 2.649 1.896a1.47 1.47 0 0 0 1.507 0c.78-.467 1.922-1.195 2.623-1.896 1.117-1.039 1.974-2.364 1.974-3.897 0-1.662-1.247-3.142-3.039-3.142-1.065 0-1.792.545-2.338 1.298-.493-.753-1.246-1.298-2.312-1.298"
                                  Fill="#FF5E5B" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Support on Ko-fi" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Open source · MIT license"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}" />
            <Button Grid.Column="1" Content="Close" Click="OnClose"
                    Style="{StaticResource AccentButton}"
                    MinWidth="85" Height="32" IsDefault="True" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
