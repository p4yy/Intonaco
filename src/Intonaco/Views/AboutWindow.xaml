<Window x:Class="Intonaco.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Intonaco"
        Icon="/Assets/intonaco.ico"
        Width="440" Height="458"
        MinWidth="440" MinHeight="458"
        MaxWidth="440" MaxHeight="458"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource DefaultFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="54" Height="54" Background="{DynamicResource SubtleBackgroundBrush}"
                    CornerRadius="14">
                <Viewbox Margin="5">
                    <Canvas Width="64" Height="64">
                        <Path Data="M18,43 L18,24 Q18,18 24,18 L44,18"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Path Data="M46,21 L46,40 Q46,46 40,46 L20,46"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Path Data="M25,37 Q31,25 38,33"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Margin="14,3,0,0" VerticalAlignment="Center">
                <TextBlock Text="Intonaco" FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="AboutVersionText" Text="Version"
                           Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Quiet, native video wallpapers for Windows. Keep your desktop in motion without accounts, browsers, or background services."
                   FontSize="13" TextWrapping="Wrap" LineHeight="21"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,19" />

        <TextBlock Grid.Row="2" Text="Links and support" FontSize="13"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,9" />

        <StackPanel Grid.Row="3">
            <Button Style="{StaticResource GhostButton}" Height="43"
                    HorizontalContentAlignment="Left" Click="OnOpenGitHub"
                    ToolTip="Open the Intonaco source code on GitHub">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="17" Margin="4,0,12,0" />
                    <TextBlock Text="GitHub" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
            </Button>
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,1" />
            <Button Style="{StaticResource GhostButton}" Height="43"
                    HorizontalContentAlignment="Left" Click="OnOpenPayPal"
                    ToolTip="Support Intonaco through PayPal">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="17" Margin="4,0,12,0" />
                    <TextBlock Text="Support on PayPal" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
            </Button>
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,1" />
            <Button Style="{StaticResource GhostButton}" Height="43"
                    HorizontalContentAlignment="Left" Click="OnOpenKoFi"
                    ToolTip="Support Intonaco through Ko-fi">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="17" Margin="4,0,12,0" />
                    <TextBlock Text="Support on Ko-fi" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Open source · MIT license"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}" />
            <Button Grid.Column="1" Content="Close" Click="OnClose"
                    Style="{StaticResource AccentButton}"
                    MinWidth="85" Height="32" IsDefault="True" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
