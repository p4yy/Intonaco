<Window x:Class="Intonaco.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Intonaco"
        Icon="/Assets/intonaco.ico"
        Width="620" Height="1080"
        MinWidth="620" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource DefaultFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="Intonaco — Live Wallpaper" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="28,18,28,14" MaxWidth="1060">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Two open frame corners and a single motion stroke. -->
            <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                <Border Background="{DynamicResource SubtleBackgroundBrush}" CornerRadius="12" />
                <Viewbox Margin="3" IsHitTestVisible="False">
                    <Canvas Width="64" Height="64">
                        <Path Data="M18,43 L18,24 Q18,18 24,18 L44,18"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Path Data="M46,21 L46,40 Q46,46 40,46 L20,46"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Path Data="M25,37 Q31,25 38,33"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="Intonaco" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Video wallpapers for Windows"
                           Style="{StaticResource CaptionText}"
                           Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse x:Name="DesktopStatusDot"
                         Width="8" Height="8"
                         Fill="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="DesktopStatusText"
                           Text="Ready"
                           Style="{StaticResource CaptionText}"
                           FontWeight="SemiBold"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}"
                        Width="36" Height="36" Padding="0"
                        Margin="15,0,0,0"
                        ToolTip="About Intonaco"
                        AutomationProperties.Name="About Intonaco"
                        Click="OnAboutClick">
                    <TextBlock Text="&#xE946;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="17"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <StackPanel Margin="28,4,28,24" MaxWidth="1060" HorizontalAlignment="Stretch">

                <!-- Wallpaper -->
                <TextBlock Text="Now playing"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,0,0,8" />

                <Border Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
                    <StackPanel>
                        <Grid x:Name="PreviewPanel" Height="300"
                              SizeChanged="OnPreviewPanelSizeChanged">
                            <Border Background="{DynamicResource PreviewBackgroundBrush}"
                                    CornerRadius="12,12,0,0" />

                            <StackPanel x:Name="PreviewPlaceholder"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="24">
                                <TextBlock Text="&#xE714;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="32"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Your desktop, in motion"
                                           Style="{StaticResource SettingTitleText}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0" />
                                <TextBlock x:Name="PreviewHintText" Text="Drop a video here or choose a file"
                                           Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <MediaElement x:Name="PreviewMedia"
                                          Stretch="UniformToFill"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Close"
                                          ScrubbingEnabled="True"
                                          IsMuted="True"
                                          Visibility="Collapsed"
                                          IsHitTestVisible="False"
                                          MediaOpened="OnPreviewMediaOpened"
                                          MediaEnded="OnPreviewMediaEnded" />

                            <Image x:Name="PreviewImage"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />

                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#66000000"
                                    CornerRadius="4"
                                    Padding="7,3"
                                    Margin="0,0,10,10"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="PreviewStatusText"
                                           Text="No video"
                                           FontSize="11"
                                           Foreground="White" />
                            </Border>

                            <Border x:Name="DropOverlay"
                                    Background="#7A065A8C"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8,8,0,0"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE896;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="30"
                                               Foreground="White"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Drop to apply"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Current wallpaper"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="FileNameText"
                                           Text="No file selected"
                                           Style="{StaticResource SettingTitleText}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,12,0" />
                                <TextBlock x:Name="FileInfoText"
                                           Text=""
                                           Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,12,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Name="OpenFolderButton"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE838;"
                                    ToolTip="Open file location"
                                    Click="OnOpenFileLocation"
                                    IsEnabled="False"
                                    Margin="8,0"
                                    VerticalAlignment="Center" />

                            <Button Grid.Column="2"
                                    x:Name="ChooseFileButton"
                                    Content="Choose video"
                                    Style="{StaticResource AccentButton}"
                                    Click="OnChooseFile"
                                    MinWidth="112"
                                    Height="32"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Seek is only sampled while this window is visible.
                             Desktop playback never waits for the UI slider. -->
                        <Grid Margin="16,0,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SeekElapsedText" Grid.Column="0" Text="0:00"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="SeekSlider" Grid.Column="1"
                                    Style="{StaticResource IntonacoSlider}"
                                    AutomationProperties.Name="Wallpaper playback position"
                                    Minimum="0" Maximum="100" Value="0"
                                    IsEnabled="False"
                                    ValueChanged="OnSeekChanged"
                                    ToolTip="Seek within wallpaper" />
                            <TextBlock x:Name="SeekDurationText" Grid.Column="2" Text="0:00"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <Border Height="1" Margin="16,0" Background="{DynamicResource DividerBrush}" />

                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PlayPauseButton"
                                    Grid.Column="0"
                                    Style="{StaticResource AccentButton}"
                                    Content="&#xE768;"
                                    ToolTip="Play"
                                    Click="OnPlayPause"
                                    IsEnabled="False"
                                    Width="40" Height="32"
                                    Padding="0"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="16" />

                            <Button x:Name="StopButton"
                                    Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE71A;"
                                    ToolTip="Stop"
                                    Click="OnStop"
                                    IsEnabled="False"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center" />

                            <Button x:Name="MuteButton"
                                    Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE74F;"
                                    ToolTip="Unmute"
                                    Click="OnToggleMute"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center" />

                            <Slider x:Name="VolumeSlider"
                                    Grid.Column="3"
                                    Style="{StaticResource IntonacoSlider}"
                                    AutomationProperties.Name="Volume"
                                    ToolTip="Volume"
                                    Minimum="0" Maximum="100"
                                    Value="0"
                                    Margin="16,0,12,0"
                                    ValueChanged="OnVolumeChanged" />

                            <TextBlock x:Name="VolumeText"
                                       Grid.Column="4"
                                       Text="0%"
                                       Width="40"
                                       Style="{StaticResource CaptionText}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />

                            <TextBlock x:Name="StatusText"
                                       Grid.Column="5"
                                       Text="Stopped"
                                       Width="92"
                                       Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent -->
                <Grid Margin="0,24,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Your wallpapers"
                               Style="{StaticResource SectionTitleText}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            x:Name="ClearRecentsButton"
                            Style="{StaticResource GhostButton}"
                            Content="Clear"
                            ToolTip="Clear recent wallpapers"
                            Click="OnClearRecentWallpapers"
                            MinHeight="28"
                            Height="28"
                            VerticalAlignment="Center" />
                </Grid>

                <Border Style="{StaticResource CardBorder}" Padding="6">
                    <StackPanel>
                        <TextBlock x:Name="RecentEmptyText"
                                   Text="Wallpapers you use will appear here."
                                   Style="{StaticResource CaptionText}"
                                   Margin="10,8" />

                        <ItemsControl x:Name="RecentList" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RecentItemButton}"
                                            HorizontalAlignment="Stretch"
                                            Height="52"
                                            Tag="{Binding FullPath}"
                                            ToolTip="{Binding FullPath}"
                                            Click="OnRecentWallpaperClick"
                                            Margin="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="&#xE714;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Width="30"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Meta}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE76C;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Discover: URLs are copied, never opened automatically.
                     The section stays collapsed until the user needs it. -->
                <Border Style="{StaticResource CardBorder}"
                        Padding="0" Margin="0,16,0,0">
                    <StackPanel>
                        <Button Style="{StaticResource GhostButton}"
                                Click="OnToggleWallpaperSources"
                                HorizontalContentAlignment="Stretch"
                                Height="62" Padding="16,8"
                                ToolTip="Show or hide places to find wallpaper videos">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Get live wallpapers"
                                               Style="{StaticResource SettingTitleText}" />
                                    <TextBlock Text="Find a video, copy its source, then add the downloaded file"
                                               Style="{StaticResource SettingDescriptionText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="WallpaperSourcesChevron"
                                           Grid.Column="1"
                                           Text="&#xE70D;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="16" VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                        <StackPanel x:Name="WallpaperSourcesPanel"
                                    Visibility="Collapsed" Margin="16,0,16,12">
                            <Border Height="1" Margin="0,0,0,8"
                                    Background="{DynamicResource DividerBrush}" />
                            <TextBlock Text="Choose a source to copy its website address. No browser opens automatically."
                                       Style="{StaticResource SettingDescriptionText}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="MotionBGs" Style="{StaticResource SettingTitleText}" />
                                    <TextBlock Text="4K, anime, games and nature"
                                               Style="{StaticResource SettingDescriptionText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy link" Tag="https://motionbgs.com/"
                                        Style="{StaticResource GhostButton}" Click="OnCopyWallpaperSource"
                                        MinWidth="96" Height="32" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" />

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="MyLiveWallpapers" Style="{StaticResource SettingTitleText}" />
                                    <TextBlock Text="Anime, gaming and abstract loops"
                                               Style="{StaticResource SettingDescriptionText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy link" Tag="https://mylivewallpapers.com/"
                                        Style="{StaticResource GhostButton}" Click="OnCopyWallpaperSource"
                                        MinWidth="96" Height="32" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" />

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="MoeWalls" Style="{StaticResource SettingTitleText}" />
                                    <TextBlock Text="Anime and illustrated live wallpapers"
                                               Style="{StaticResource SettingDescriptionText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy link" Tag="https://moewalls.com/"
                                        Style="{StaticResource GhostButton}" Click="OnCopyWallpaperSource"
                                        MinWidth="96" Height="32" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" />

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Pexels Videos" Style="{StaticResource SettingTitleText}" />
                                    <TextBlock Text="Nature and free stock video loops"
                                               Style="{StaticResource SettingDescriptionText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy link" Tag="https://www.pexels.com/search/videos/loop/"
                                        Style="{StaticResource GhostButton}" Click="OnCopyWallpaperSource"
                                        MinWidth="96" Height="32" />
                            </Grid>
                            <TextBlock Text="Independent websites. Check each download format and usage rights. Intonaco uses local video files."
                                       Style="{StaticResource SettingDescriptionText}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock x:Name="WallpaperSourceCopyStatus" Text=""
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Playback -->
                <TextBlock Text="Playback settings"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,24,0,8" />

                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <StackPanel>
                        <!-- Optional renderer. No MPV binaries are bundled with Intonaco. -->
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Video engine" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Windows is built in; MPV is optional"
                                           Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>
                            <ComboBox x:Name="BackendComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource IntonacoComboBox}"
                                      Width="155" VerticalAlignment="Center"
                                      AutomationProperties.Name="Video playback engine"
                                      SelectionChanged="OnBackendChanged">
                                <ComboBoxItem Content="Windows" Tag="Windows" IsSelected="True" />
                                <ComboBoxItem Content="MPV (optional)" Tag="MPV" />
                            </ComboBox>
                        </Grid>
                        <Border Height="1" Margin="16,0" Background="{DynamicResource DividerBrush}" />
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Fit" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Choose how the video fits the screen"
                                           Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>

                            <ComboBox x:Name="FitComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource IntonacoComboBox}"
                                      Width="150"
                                      SelectionChanged="OnFitChanged"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="Fill screen" Tag="Fill" IsSelected="True" />
                                <ComboBoxItem Content="Fit frame" Tag="Fit" />

                            </ComboBox>
                        </Grid>

                        <Border Height="1" Margin="16,0" Background="{DynamicResource DividerBrush}" />

                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Playback speed" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Change the speed of the video"
                                           Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>

                            <ComboBox x:Name="SpeedComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource IntonacoComboBox}"
                                      Width="120"
                                      SelectionChanged="OnSpeedChanged"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="0.5×" Tag="0.5" />
                                <ComboBoxItem Content="0.75×" Tag="0.75" />
                                <ComboBoxItem Content="1×" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="1.25×" Tag="1.25" />
                                <ComboBoxItem Content="1.5×" Tag="1.5" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Margin="16,0" Background="{DynamicResource DividerBrush}" />

                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Frame rate" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Preferred playback frame rate"
                                           Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>

                            <ComboBox x:Name="FpsComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource IntonacoComboBox}"
                                      Width="120"
                                      SelectionChanged="OnFpsChanged"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="15 fps" Tag="15" />
                                <ComboBoxItem Content="24 fps" Tag="24" />
                                <ComboBoxItem Content="30 fps" Tag="30" IsSelected="True" />
                                <ComboBoxItem Content="60 fps" Tag="60" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Margin="16,0" Background="{DynamicResource DividerBrush}" />

                        <CheckBox x:Name="LoopToggle"
                                  Style="{StaticResource IntonacoToggle}"
                                  Margin="16,10"
                                  Checked="OnLoopChanged"
                                  Unchecked="OnLoopChanged">
                            <StackPanel>
                                <TextBlock Text="Loop playback" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Restart the video when it ends"
                                           Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>
                        </CheckBox>

                        <Border Height="1" Margin="16,0" Background="{DynamicResource DividerBrush}" />

                        <!-- Background animation mode: an explicit choice of
                             two behaviours, persisted across restarts. Manual
                             pause is separate and always wins. -->
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                <TextBlock Text="When another app is active"
                                           Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Pause to save resources, or keep the wallpaper moving."
                                           Style="{StaticResource SettingDescriptionText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox x:Name="BackgroundAnimationComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource IntonacoComboBox}"
                                      Width="190"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnBackgroundAnimationModeChanged">
                                <ComboBoxItem Content="Pause (recommended)"
                                              Tag="PauseWhenUnfocused"
                                              IsSelected="True" />
                                <ComboBoxItem Content="Keep playing"
                                              Tag="ContinueWhenUnfocused" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Text="Preferences"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,24,0,8" />

                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <StackPanel>
                        <CheckBox x:Name="StartWithWindowsToggle"
                                  Style="{StaticResource IntonacoToggle}"
                                  Margin="16,10"
                                  Checked="OnStartupChanged"
                                  Unchecked="OnStartupChanged">
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Launch Intonaco when you sign in"
                                           Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>
                        </CheckBox>

                        <Border Height="1" Margin="16,0" Background="{DynamicResource DividerBrush}" />

                        <CheckBox x:Name="StartMinimizedToggle"
                                  Style="{StaticResource IntonacoToggle}"
                                  Margin="16,10"
                                  Checked="OnStartMinimizedChanged"
                                  Unchecked="OnStartMinimizedChanged">
                            <StackPanel>
                                <TextBlock Text="Start minimized" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Launch in the tray when Windows starts"
                                           Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>
                        </CheckBox>

                        <Border Height="1" Margin="16,0" Background="{DynamicResource DividerBrush}" />

                        <CheckBox x:Name="AutoPlayToggle"
                                  Style="{StaticResource IntonacoToggle}"
                                  Margin="16,10"
                                  Checked="OnAutoPlayChanged"
                                  Unchecked="OnAutoPlayChanged">
                            <StackPanel>
                                <TextBlock Text="Resume last wallpaper" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Apply the previous wallpaper when Intonaco starts"
                                           Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>
                        </CheckBox>

                        <Border Height="1" Margin="16,0" Background="{DynamicResource DividerBrush}" />

                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Theme" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="Choose the app appearance"
                                           Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>

                            <ComboBox x:Name="ThemeComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource IntonacoComboBox}"
                                      Width="120"
                                      SelectionChanged="OnThemeChanged"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="System" Tag="System" IsSelected="True" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorText"
                           Grid.Column="0"
                           Text=""
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                <Button Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Content="Open logs"
                        ToolTip="Open the Intonaco log folder"
                        Click="OnOpenLogs"
                        MinHeight="28"
                        Height="28"
                        VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           x:Name="VersionText"
                           Text="v1.0.0"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- System tray icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/intonaco.ico"
                        ToolTipText="Intonaco"
                        DoubleClickCommand="{x:Null}"
                        Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="TrayShowItem" Header="Show Intonaco" Click="OnTrayShow" FontWeight="Bold" />
                    <Separator />
                    <MenuItem x:Name="TrayPlayPauseItem" Header="Play" Click="OnTrayPlayPause" />
                    <MenuItem Header="Choose video…" Click="OnTrayChooseVideo" />
                    <MenuItem x:Name="TrayMuteItem" Header="Mute" Click="OnTrayToggleMute" />
                    <Separator />
                    <MenuItem Header="Settings" Click="OnTraySettings" />
                    <MenuItem Header="Exit" Click="OnTrayExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
